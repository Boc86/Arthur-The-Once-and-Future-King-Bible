#!/bin/bash

set -e

BASE="001_Unity/Implementation"

echo "Creating implementation documentation structure..."

mkdir -p "$BASE"

create_doc () {
    FILE="$BASE/$1"
    TITLE="$2"
    ID="$3"

    if [ -f "$FILE" ]; then
        echo "Skipping existing: $FILE"
        return
    fi

    cat > "$FILE" <<EOF
---
title: $TITLE
document_id: $ID
version: 0.1
status: Draft
owner: Gameplay Architecture
engine: Unity 6 LTS
implemented: false
last_updated: 2026-08-05
---

# Arthur: The Once and Future King

# $TITLE

Version 0.1

---

# Purpose

This document defines the implementation requirements for:

$TITLE

---

# Implementation Status

Status:

\`\`\`
Draft
\`\`\`

---

# Dependencies

Required systems:

\`\`\`
Core Framework
Player Systems
Combat Systems
World Systems
\`\`\`

---

# Architecture

The system follows:

\`\`\`
Data

↓

Systems

↓

Events

↓

Gameplay
\`\`\`

---

# Folder Structure

Recommended:

\`\`\`
Assets/Game/

├── Scripts

├── Data

├── Prefabs

├── UI

└── Systems
\`\`\`

---

# Required Components

Components will be defined during implementation.

---

# System Requirements

The system must be:

- Modular
- Data driven
- Expandable
- Compatible with future content

---

# Testing Requirements

Required tests:

\`\`\`
Compilation

Runtime Testing

Integration Testing

Performance Testing
\`\`\`

---

# AI Agent Rules

Before implementation:

\`\`\`
Read related design documents

Read dependency systems

Follow architecture rules
\`\`\`

During implementation:

\`\`\`
Avoid hardcoded logic

Use Scriptable Objects

Use Events

Keep systems separated
\`\`\`

After implementation:

\`\`\`
Compile

Test

Document
\`\`\`

---

# Acceptance Criteria

Complete when:

✓ System exists

✓ Documentation matches implementation

✓ Tests pass

✓ Future expansion is possible

---

# Definition Of Done

$TITLE is complete when the system functions as a stable foundation for Arthur: The Once and Future King.
EOF

    echo "Created $FILE"
}


create_doc "IMP-002_Player_Controller_Implementation.md" \
"Player Controller Implementation" \
"IMP-002"

create_doc "IMP-003_Isometric_Camera_System.md" \
"Isometric Camera System Implementation" \
"IMP-003"

create_doc "IMP-004_Combat_Framework_Implementation.md" \
"Combat Framework Implementation" \
"IMP-004"

create_doc "IMP-005_Enemy_AI_Framework_Implementation.md" \
"Enemy AI Framework Implementation" \
"IMP-005"

create_doc "IMP-006_Loot_System_Implementation.md" \
"Loot System Implementation" \
"IMP-006"

create_doc "IMP-007_Character_Progression_Implementation.md" \
"Character Progression Implementation" \
"IMP-007"

create_doc "IMP-008_First_Playable_Prototype_Milestone.md" \
"First Playable Prototype Milestone" \
"IMP-008"

create_doc "IMP-009_UI_HUD_Framework_Implementation.md" \
"UI HUD Framework Implementation" \
"IMP-009"

create_doc "IMP-010_Save_Load_System_Implementation.md" \
"Save And Load System Implementation" \
"IMP-010"

create_doc "IMP-011_Ability_System_Implementation.md" \
"Ability System Implementation" \
"IMP-011"


echo ""
echo "====================================="
echo "Arthurian Implementation Docs Created"
echo "====================================="

ls -la "$BASE"
